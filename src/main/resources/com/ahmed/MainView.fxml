<!-- Root VBox - Set the fx:controller here -->

<VBox prefHeight="733.0" prefWidth="944.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ahmed.MainTabController">
    <children>
        <!-- Top Container for MenuBar and Global Controls -->
        <VBox>
            <children>
                <MenuBar fx:id="menuBar">
                    <menus>
                        <Menu mnemonicParsing="false" text="File">
                     <items>
                        <Menu fx:id="openRecentMenu" mnemonicParsing="false" text="Open Recent">
                          <items>
                            <MenuItem mnemonicParsing="false" text="Action 1" />
                          </items>
                        </Menu>
                        <MenuItem fx:id="exportAllMenuItem" mnemonicParsing="false" onAction="#handleExportAllAction" text="Export All" />
                     </items></Menu>
                  <Menu mnemonicParsing="false" text="Tools">
                    <items>
                      <MenuItem fx:id="trimFileMenuItem" mnemonicParsing="false" onAction="#handleTrimFileAction" text="Trim Current FIle" />
                    </items>
                  </Menu>
                    </menus>
                </MenuBar>

                <!-- Global Top Panel (HBox) - Contains file selection and processing limit controls -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #e0e0e0; -fx-border-color: #d0d0d0; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>
                        <Label text="Open File:" />
                        <TextField fx:id="filePathField" editable="false" prefWidth="400.0" text="No file selected" />
                        <!-- Button duplicates menu item functionality, also linked to handleSelectFileAction -->
                        <Button mnemonicParsing="false" onAction="#handleOpenFileAction" text="Select FASTQ File" />
                        <Label text="Processing Limit (reads):" />
                        <TextField fx:id="processingLimitField" prefWidth="120.0" promptText="0" />
                        <!-- Linked to runAnalysis -->
                        <Button fx:id="analyzeButton" disable="true" mnemonicParsing="false" onAction="#runAnalysis" text="Analyze" />
                    </children>
                </HBox>
            </children>
        </VBox>
      <TabPane fx:id="tabPane" prefHeight="683.0" prefWidth="944.0" tabClosingPolicy="UNAVAILABLE" />
    </children>
</VBox>
